#!/bin/sh
# A general-purpose extraction script.
# Default behavior: extract archive into new directory.
# Use -c to extract into current directory.

set -eu

extract_here=false

usage() {
    printf 'Usage: %s [-c] <archive>\n' "$0"
    printf '  -c    Extract into current directory instead of a new folder\n'
}

while getopts 'hc' o; do
    case "$o" in
        c) extract_here=true ;;
        h)
            usage
            exit 0
            ;;
        *)
            usage
            exit 1
            ;;
    esac
done

shift $((OPTIND - 1))

[ "$#" -eq 1 ] || {
    usage >&2
    exit 1
}

archive=$(readlink -f "$1")

[ -f "$archive" ] || {
    printf 'File "%s" not found.\n' "$archive" >&2
    exit 1
}

if [ "$extract_here" = false ]; then
    archive_name=$(basename "$archive")
    directory=${archive_name%.*}
    mkdir -p "$directory"
    cd "$directory"
fi

case "$archive" in
    *.tar.bz2|*.tbz2) tar xvjf "$archive" ;;
    *.tar.xz|*.txz) tar xvJf "$archive" ;;
    *.tar.gz|*.tgz) tar xvzf "$archive" ;;
    *.lzma) unlzma "$archive" ;;
    *.bz2) bunzip2 "$archive" ;;
    *.rar) unrar x -ad "$archive" ;;
    *.gz) gunzip "$archive" ;;
    *.tar) tar xvf "$archive" ;;
    *.zip) unzip "$archive" ;;
    *.Z) uncompress "$archive" ;;
    *.7z) 7z x "$archive" ;;
    *.xz) unxz "$archive" ;;
    *.exe) cabextract "$archive" ;;
    *)
        printf "extract: '%s' - unknown archive method\n" "$archive" >&2
        exit 1
        ;;
esac
