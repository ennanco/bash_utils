#!/usr/bin/env bash
# Toggle a small always-on-top webcam preview in the bottom-right corner.

set -euo pipefail

VIDEO_DEVICE="${VIDEO_DEVICE:-/dev/video0}"

if pgrep -f "mpv.*${VIDEO_DEVICE}" >/dev/null 2>&1; then
    pkill -f "mpv.*${VIDEO_DEVICE}"
    exit 0
fi

command -v mpv >/dev/null 2>&1 || {
    echo "mpv is required but was not found in PATH." >&2
    exit 1
}

[[ -e "$VIDEO_DEVICE" ]] || {
    echo "Video device not found: $VIDEO_DEVICE" >&2
    exit 1
}

exec mpv --geometry=-0-0 --autofit=20% --no-border --ontop "$VIDEO_DEVICE"
